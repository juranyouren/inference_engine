{
  "alarm_type": "网络设备掉线",
  "decision_templates": {
    "step_01": {
      "condition": "检查设备分区device level 是否为 L1 设备.",
      "diagnostic_clue_paths": [
        "$.semantic_labels.other_info.device_info.local_device.device_level"
      ],
      "guidance": "依据 device_level 的明确分区或已确认的型号映射判断。只有型号且缺少映射时保留未知。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    },
    "step_02": {
      "condition": "检查服务器 resource_status是否正常运行.",
      "diagnostic_clue_paths": [
        "$.semantic_labels.other_info.device_info.local_server_status"
      ],
      "guidance": "仅依据所属服务器的 resource_status 判断，服务器状态对象为空时保留未知。按原文评估条件，在理由中注明正常运行的分支与服务器未运行结论之间的冲突。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    },
    "step_04": {
      "condition": "检查设备信息sys_running_time,是否掉线(sys_running_time是否存在).",
      "diagnostic_clue_paths": [
        "$.semantic_labels.other_info.command_echo_info.sys_running_time"
      ],
      "guidance": "按原文括号中的 sys_running_time 是否存在判断。样例的空对象表示未取得。字段缺失且无法确认原因时保留未知。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    },
    "step_05": {
      "condition": "检查设备信息告警首次发生时间alarm_time与sys_running_time的差是否小于360000ms（判断设备是否重启）.",
      "diagnostic_clue_paths": [
        "$.semantic_labels.other_info.command_echo_info.sys_running_time",
        "$.alarm_time"
      ],
      "guidance": "对齐时间含义与单位后核对严格小于 360000 毫秒的条件。如果差值方向、是否取绝对值或时间字段口径不明确，且会影响判断，保留未知。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    },
    "step_06": {
      "condition": "检查历史重启命令是否存在（判断是否人为变更导致重启）.",
      "diagnostic_clue_paths": [
        "$.semantic_labels.other_info.command_echo_info.other_command_echo[*]"
      ],
      "guidance": "寻找时间与设备均匹配的历史 reboot/reload 命令。只有明确完成了相关历史查询且无匹配记录时才填 false。通用命令回显为空不代表专用历史查询无结果，专用查询结果的 case 字段待确认。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    },
    "step_09": {
      "condition": "检查告警时间前后1分钟接口丢包率 offline_loss_rate 是否超过 100%.",
      "diagnostic_clue_paths": [
        "$.semantic_labels.anomaly_kpi.offline_loss_rate.abnormal_timing_segments[*]",
        "$.alarm_time"
      ],
      "guidance": "统一告警时间和 KPI 时间戳的单位，引用告警前后各 1 分钟内的实际采样值。按原文评估是否严格超过 100%，并在理由中注明与等于 100% 的根因标签之间的冲突。无法将样本定位到该时间窗口时保留未知。",
      "result_template": {
        "diagnostic_clues": [],
        "condition_met": null,
        "confidence": null,
        "reason": ""
      }
    }
  },
